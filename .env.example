# Configure PostgreSQL before starting Datalog.
# For production, inject credentials through your deployment secret manager.
POSTGRES_PASSWORD=replace-with-a-strong-local-password
DATABASE_URL=postgresql://datalog:replace-with-a-strong-local-password@127.0.0.1:55432/datalog
# Optional: override the internal DSN for the Compose stack profile (default: postgresql://datalog:${POSTGRES_PASSWORD}@postgres:5432/datalog).
# DATALOG_COMPOSE_DATABASE_URL=postgresql://datalog:replace-with-a-strong-local-password@postgres:5432/datalog
# DATALOG_BIND=127.0.0.1
# Requests processed at once before answering 503 (open sockets are capped at 4x), and PostgreSQL pool size.
# DATALOG_MAX_CONNECTIONS=64
# DATALOG_DB_POOL_SIZE=10

# Optional Docker Compose host ports (bound to 127.0.0.1).
# DATALOG_PG_PORT=55432
# DATALOG_APP_PORT=4310
# DATALOG_OTLP_GRPC_PORT=4317
# DATALOG_OTLP_HTTP_PORT=4318
# DATALOG_QUEUE_METRICS_PORT=8888

# Optional Collector / CLI variables.
# DATALOG_PROJECT=local
# DATALOG_INGESTION_KEY=
# DATALOG_EVALUATION_TOKEN=

# Optional HTTPS origin when published behind a TLS reverse proxy.
# DATALOG_PUBLIC_ORIGIN=https://observability.example
# Dedicated Bearer token for Prometheus scraping on /internal/metrics.
# DATALOG_INTERNAL_METRICS_TOKEN=
# DATALOG_OIDC_ISSUER=
# DATALOG_OIDC_CLIENT_ID=
# DATALOG_OIDC_CLIENT_SECRET=
# Alert destinations are scoped per project ("*" = every project):
# DATALOG_ALERT_DESTINATIONS={"ops-slack":{"type":"slack","url":"https://hooks.slack.com/...","projects":["local"]}}
# DATALOG_MODEL_ADAPTERS={}
# DATALOG_DATA_SOURCES={}
# See docs/data-observability.md for configuring read-only database sources.
# DATALOG_SYNTHETIC_TARGETS={}
# DATALOG_CHROMIUM=
# DATALOG_PROBE_LOCATION=local
# Let any signed-in user create projects (default: only project admins; operators can use `datalog-manage create-project`).
# DATALOG_OPEN_PROJECT_CREATION=false
# Reverse proxies whose X-Forwarded-For is trusted for per-client sign-in limits (comma-separated IPs).
# DATALOG_TRUSTED_PROXIES=127.0.0.1
# Maximum duration of a single database query, in milliseconds.
# DATALOG_STATEMENT_TIMEOUT_MS=30000
